# ============================================================
#  broadarks-backend — environment variables
#  Copy this file to `.env.local` and fill in the real values.
#  NEVER commit `.env.local`.
# ============================================================

# --- Supabase -------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
# Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Public anon key (safe for the browser, guarded by RLS).
# Supabase dashboard → Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service-role key — FULL ACCESS, bypasses row-level security.
# SERVER-ONLY. Never expose to the browser / never prefix with NEXT_PUBLIC_.
# Supabase dashboard → Project Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Admin auth ----------------------------------------------
# Secret used to sign session cookies (HMAC). Use a long random string.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# How long a login stays valid, in seconds (default 7 days).
AUTH_SESSION_TTL=604800
